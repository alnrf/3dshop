// Loja de impressões 3D — schema multi-tenant (modelo A / white-label).
// Uma loja hoje (a sua) = primeiro registro em Store. Cada tabela de negócio
// carrega storeId, então adicionar lojas depois não muda a forma das queries.
// Valores monetários em centavos (Int), nunca Float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenant + acesso ──────────────────────────────────────────────────────────

model Store {
  id     String @id @default(cuid())
  slug   String @unique // usado no path/subdomínio: /loja/<slug>
  name   String
  plan   String @default("free") // free | pro | ...
  status String @default("active") // pending (aguardando aprovação) | active | suspended

  // Aceite do contrato de serviço no onboarding self-service.
  contractAcceptedAt DateTime?

  // Credenciais do gateway DESTA loja (modelo A: cada loja recebe na própria conta).
  // Preferir OAuth/Connect a chave crua; o que for guardado vai ENCRIPTADO em repouso.
  paymentConfig  Json?
  // Credenciais/preferência de frete DESTA loja (Superfrete, Melhor Envio, ...).
  // Mesma regra: segredo vai ENCRIPTADO em repouso (ver lib/crypto.ts).
  // Reservado pra cotação real; o checkout hoje usa flatShippingCents abaixo.
  shippingConfig Json?

  // Frete fixo usado de fato pelo checkout (fase atual, sem cotação real).
  // Null = lojista não configurou — checkout cai num valor padrão (ver
  // DEFAULT_FLAT_SHIPPING_CENTS em lib/checkout.ts) em vez de bloquear.
  flatShippingCents         Int?
  freeShippingThresholdCents Int?

  // Logotipo exibido no navbar do storefront (R2, mesmo padrão do ProductImage.r2Key).
  logoKey String?

  // Assinatura do plano Pro (plataforma cobrando o lojista — Stripe Billing).
  // Distinto de paymentConfig acima, que é o gateway da própria loja para
  // cobrar o cliente final. Fonte de verdade do plano em si continua sendo
  // `plan`; estes campos só rastreiam a assinatura no Stripe que o mantém
  // sincronizado via webhook (ver app/api/webhooks/stripe).
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  subscriptionStatus   String? // espelha Stripe: active | past_due | canceled | ...

  memberships Membership[]
  products    Product[]
  coupons     Coupon[]
  customers   Customer[]
  carts       Cart[]
  orders      Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Operadores do painel (você e assinantes). Distinto de Customer (comprador).
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  platformRole String? // null = comum; "admin" = dono da plataforma (você)

  // Dados de contato/documento coletados no onboarding self-service. Opcionais
  // porque usuários criados antes desta coluna (seed, Google direto) não têm.
  phone String?
  cnpj  String?

  // Pra contrato ter validade jurídica: CPF de quem assina (CNPJ sozinho não
  // identifica uma pessoa física) e endereço completo. `name` já guarda o
  // nome da pessoa responsável — não duplicado aqui.
  cpf     String?
  address Json?

  // Login por credencial (onboarding self-service). Google não usa nenhum dos dois.
  passwordHash       String?
  mustChangePassword Boolean @default(false)

  memberships Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MemberRole {
  owner
  staff
}

model Membership {
  id      String     @id @default(cuid())
  userId  String
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId String
  store   Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  role    MemberRole @default(owner)

  @@unique([userId, storeId]) // um vínculo por par usuário/loja
  @@index([storeId])
}

// ─── Catálogo ────────────────────────────────────────────────────────────────

model Product {
  id          String  @id @default(cuid())
  storeId     String
  store       Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String?
  material    String? // ex.: PLA, PETG, resina
  printTime   String? // ex.: "cerca de 4 horas"
  priceCents  Int
  stock       Int     @default(0)
  active      Boolean @default(true)

  // Livres, normalizadas em minúsculo no save (lib/format.ts normalizeTags)
  // pra busca por nome/tag funcionar sem se importar com caixa.
  tags String[] @default([])

  // Necessários para cotar frete. Float em tudo — impressão 3D tem peso e
  // medidas pequenos/fracionados (ex.: 12.5g, 8.3cm) e casa decimal importa.
  weightGrams Float
  widthCm     Float
  heightCm    Float
  lengthCm    Float

  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug]) // slug único por loja, não globalmente
  @@index([storeId, active])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  r2Key     String
  position  Int     @default(0)

  @@index([productId])
}

// Desconto no valor final (percentual ou fixo) ou frete grátis. Cadastro e
// gerenciamento prontos; a APLICAÇÃO no carrinho/checkout fica pra quando o
// checkout em si existir (hoje é pendência conhecida do projeto — sem
// checkout, não tem onde validar/consumir o cupom de verdade ainda).
enum CouponType {
  percentage // percentOff: 1–100
  fixed // valueCents: desconto fixo, em centavos
  free_shipping // zera o frete; percentOff/valueCents ignorados
}

model Coupon {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  code String // normalizado maiúsculo no save (ex.: "BEMVINDO10")
  type CouponType

  percentOff Int? // 1–100, usado quando type = percentage
  valueCents Int? // centavos, usado quando type = fixed

  active        Boolean   @default(true)
  startsAt      DateTime?
  expiresAt     DateTime?
  maxUses       Int? // null = sem limite de usos
  usedCount     Int       @default(0)
  minOrderCents Int? // pedido mínimo pra poder usar — null = sem mínimo

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Pedidos que usaram este cupom (snapshot em Order.couponCode/couponType/
  // discountCents — ver lá; esta relação é só pra navegação enquanto o cupom existir).
  orders Order[]

  @@unique([storeId, code]) // código único por loja, não globalmente
  @@index([storeId, active])
}

// ─── Compradores (por loja) ───────────────────────────────────────────────────

model Customer {
  id        String  @id @default(cuid())
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  email     String
  phone     String?
  cpf       String? // pro CNPJ/CPF na nota fiscal (emissão ainda não existe — só cadastro)
  addresses Json?

  // Login por e-mail/senha desta loja (opcional — Google continua funcionando sem isto).
  passwordHash String?

  cart                Cart?
  orders              Order[]
  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, email]) // mesmo e-mail pode existir em lojas diferentes
  @@index([storeId])
}

// Recuperação de senha do comprador. `token` guarda o HASH (sha256) do token
// que vai por e-mail — só o link em si prova posse do e-mail, o banco não
// guarda nada usável sozinho. Curta validade (1h) e uso único (consomeAt).
model PasswordResetToken {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

// ─── Carrinho ────────────────────────────────────────────────────────────────

model Cart {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  token      String    @unique @default(cuid()) // cookie cart_token (convidado)
  customerId String?   @unique // null = convidado
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty       Int     @default(1)

  @@unique([cartId, productId])
  @@index([cartId])
}

// ─── Pedidos ─────────────────────────────────────────────────────────────────

enum PaymentStatus {
  pending
  approved
  rejected
  refunded
}

enum FulfillmentStatus {
  awaiting_payment
  paid
  printing
  shipped
  delivered
  canceled
}

// Suporta a encomenda com sinal: deposit (sinal) + balance (saldo), ou full.
enum PaymentKind {
  full
  deposit
  balance
}

model Order {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  subtotalCents Int
  shippingCents Int @default(0)
  discountCents Int @default(0)
  totalCents    Int

  // Cupom aplicado, congelado no momento da compra (code/type), não só
  // referenciado — deleteCouponFormAction apaga o Coupon sem guarda nenhuma,
  // então só a FK quebraria a legibilidade do histórico depois de excluído.
  couponId   String?
  coupon     Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode String?
  couponType CouponType?

  paymentStatus     PaymentStatus     @default(pending)
  fulfillmentStatus FulfillmentStatus @default(awaiting_payment)
  // true = item sem estoque no momento da compra, impresso sob encomenda —
  // o fluxo de status ganha o passo "printing". false = pronta entrega, pula
  // direto de "paid" pra "shipped" (o item já existe fisicamente).
  madeToOrder       Boolean           @default(false)

  shippingAddress         Json
  trackingCode            String?
  shippingProviderOrderId String?

  items    OrderItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, fulfillmentStatus])
  @@index([customerId])
  @@index([couponId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Int

  unitPriceCents Int // preço congelado no momento da compra

  @@index([orderId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind              PaymentKind   @default(full) // sinal / saldo / integral
  provider          String        @default("mercadopago")
  providerPaymentId String?       @unique
  amountCents       Int
  status            PaymentStatus @default(pending)
  rawPayload        Json?

  // Forma de pagamento informada manualmente ao confirmar ("pix" | "cartao" |
  // "dinheiro") — só preenchido na confirmação manual (sem gateway ainda);
  // distinto de `provider`, que identifica o gateway quando houver um de verdade.
  method String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}
