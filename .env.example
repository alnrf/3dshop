# ─── Banco (Postgres no MiniDeskServer via Docker) ─────────────
DATABASE_URL="postgresql://loja:loja3d_dev@192.168.50.92:5432/loja3d?sslmode=disable"

# ─── Auth.js ───────────────────────────────────────────────────
# Gere com: npx auth secret
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Rodando o app fora de localhost, defina a URL base:
# AUTH_URL="http://192.168.50.92:3000"
# AUTH_TRUST_HOST=true

# ─── Storage S3-compatível (MinIO no MiniDeskServer, dev) ──────
S3_ENDPOINT="http://192.168.50.92:9000"
S3_FORCE_PATH_STYLE="true"
S3_ACCESS_KEY_ID="loja3d"
S3_SECRET_ACCESS_KEY="loja3d_dev_secret"
S3_BUCKET="loja3d"
S3_PUBLIC_URL="http://192.168.50.92:9000/loja3d"

# Em produção (R2): S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com,
# S3_FORCE_PATH_STYLE=false, S3_PUBLIC_URL=https://cdn.seudominio.dev

# ─── Plataforma / seed ─────────────────────────────────────────
PLATFORM_ADMIN_EMAILS="voce@email.com"
SEED_ADMIN_EMAIL="voce@email.com"

# ─── Segredos de configuração por loja (pagamento/frete) ───────
# Gere com: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=""

# ─── Assinatura da plataforma (Stripe Billing) ──────────────────
# Cobra o LOJISTA pelo plano Pro — não confundir com o gateway de cada loja
# (S3_*/paymentConfig acima), que cobra o cliente final. Sem estas três
# variáveis, a tela /admin/plano funciona mas mostra "assinatura ainda não
# configurada" e o botão "Assinar Pro" fica desabilitado.
# 1. dashboard.stripe.com (modo teste) → Developers → API keys → Secret key
STRIPE_SECRET_KEY=""
# 2. Product catalog → novo produto "Plano Pro" → Price recorrente → ID (price_...)
STRIPE_PRICE_PRO=""
# 3. Em dev, use a Stripe CLI: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
#    — ela imprime este segredo (whsec_...). Em produção, cadastre o endpoint
#    em Developers → Webhooks e copie o "Signing secret" de lá.
STRIPE_WEBHOOK_SECRET=""
